# Copy to .env locally. Never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Default specialist assignment; each model name must be available to your account.
MECHANICS_PROVIDER=openai
FABRICATION_PROVIDER=anthropic
MEASUREMENT_PROVIDER=gemini
COFORM_DATA_DIR=data

# Local PreForm Insider / PreForm Server; preserves its existing login.
FORMLABS_PREFORM_PORT=44388
# Persistent limits across live rounds. Costs are estimates/reservations.
COFORM_LIVE_MAX_USD=0.05
COFORM_LIVE_MAX_CALLS=6
COFORM_LIVE_MAX_CALLS_PER_PROVIDER=2
COFORM_LIVE_LEDGER=data/live-pilot.sqlite3

# Onshape API keys (dev-portal.onshape.com/keys, read+write) and the Part Studio tab URL.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
ONSHAPE_PART_STUDIO_URL=
# ONSHAPE_BASE_URL=https://cad.onshape.com

# FreeCAD (optional override; auto-detected under %LOCALAPPDATA%\Programs\FreeCAD*).
# FREECAD_CMD=C:\Users\you\AppData\Local\Programs\FreeCAD 1.1\bin\FreeCADCmd.exe

# NVIDIA hosted models (build.nvidia.com key). Set *_PROVIDER=nvidia to use them.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Optional per-role models (same provider) and the single-agent baseline's provider.
# MECHANICS_MODEL=
# SINGLE_AGENT_PROVIDER=nvidia
# Free-credit call cap, separate from the paid-provider dollar/call limits above.
COFORM_NVIDIA_MAX_CALLS=2000

# Part designer retry limits per invocation (1-50 each). Token/spending guards still apply.
COFORM_DESIGN_MAX_DRAFT_ATTEMPTS=12
COFORM_DESIGN_MAX_ROUNDS=12
COFORM_DESIGN_MAX_REVIEW_CYCLES=8
COFORM_DESIGN_MAX_STALLED_ROUNDS=8
COFORM_DESIGN_MAX_STALLED_DRAFT_ATTEMPTS=3
