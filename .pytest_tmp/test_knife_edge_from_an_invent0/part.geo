SetFactory("OpenCASCADE");
Geometry.OCCTargetUnit = "MM";
Box(1) = {0,0,0, 4,80,80};
fv1 = 1;
Box(2) = {0,0,4, 120,40,10};
fv2 = 2;
Box(3) = {85,40,4, 35,12,10};
fv3 = 3;
Box(4) = {4,15,14, 116,10,10};
fv4 = 4;
Rotate {{0,1,0},{4,15,14},-0.78539816} { Volume{fv4}; }
Cylinder(5) = {-1,10,10, 6,0,0, 2.25};
fv5 = 5;
Cylinder(6) = {-1,70,10, 6,0,0, 2.25};
fv6 = 6;
Cylinder(7) = {-1,10,70, 6,0,0, 2.25};
fv7 = 7;
Cylinder(8) = {-1,70,70, 6,0,0, 2.25};
fv8 = 8;
Box(9) = {0,0,4, 4,10,2};
fv9 = 9;
part() = {fv1};
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv2}; Delete; };
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv3}; Delete; };
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv4}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv5}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv6}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv7}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv8}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv9}; Delete; };
Printf("SOLIDS %g", #part());
Save "part.step";
