SetFactory("OpenCASCADE");
Geometry.OCCTargetUnit = "MM";
Box(1) = {0,0,0, 4,25,80};
fv1 = 1;
Box(2) = {0,0,76, 100,25,4};
fv2 = 2;
Point(3001) = {3.5,11,76.5};
Point(3002) = {53.5,11,76.5};
Point(3003) = {3.5,11,26.5};
Line(3001) = {3001,3002};
Line(3002) = {3002,3003};
Line(3003) = {3003,3001};
Curve Loop(3000) = {3001,3002,3003};
Plane Surface(3000) = {3000};
ex3[] = Extrude {0,3,0} { Surface{3000}; };
fv3 = ex3[1];
Cylinder(4) = {-1,12.5,26.6667, 6,0,0, 2.5};
fv4 = 4;
Box(5) = {300,0,0, 5,5,5};
fv5 = 5;
part() = {fv1};
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv2}; Delete; };
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv3}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv4}; Delete; };
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv5}; Delete; };
Printf("SOLIDS %g", #part());
Save "part.step";
