SetFactory("OpenCASCADE");
Geometry.OCCTargetUnit = "MM";
Box(1) = {0,-20,0, 6,40,60};
fv1 = 1;
Box(2) = {6,-12.5,52, 68,25,8};
fv2 = 2;
Box(3) = {74,-12.5,52, 12,25,12};
fv3 = 3;
Cylinder(4) = {74,0,64, 0,25,0, 12};
fv4 = 4;
Box(5) = {74,-12.5,64, 12,25,12};
fv5 = 5;
Box(6) = {0,-2.5,12, 74,5,40};
fv6 = 6;
Rotate {{0,1,0},{0,-2.5,12},-0.78539816} { Volume{fv6}; }
Cylinder(7) = {0,-10,20, 8,0,0, 3};
fv7 = 7;
Cylinder(8) = {0,10,20, 8,0,0, 3};
fv8 = 8;
Cylinder(9) = {0,-10,40, 8,0,0, 3};
fv9 = 9;
Cylinder(10) = {0,10,40, 8,0,0, 3};
fv10 = 10;
part() = {fv1};
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv2}; Delete; };
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv3}; Delete; };
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv4}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv5}; Delete; };
part() = BooleanUnion{ Volume{part()}; Delete; }{ Volume{fv6}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv7}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv8}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv9}; Delete; };
part() = BooleanDifference{ Volume{part()}; Delete; }{ Volume{fv10}; Delete; };
Printf("SOLIDS %g", #part());
Save "part.step";
